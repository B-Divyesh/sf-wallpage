# Sociobot supplies these when Collector checkout is registered.
# Do not put secrets in Vite variables: all VITE_ values are public at runtime.
VITE_SOCIOBOT_BUY_URL=
# Exact product verifier URL. The client calls GET <url>?license=<token>.
# Example: https://api.sociobot.in/api/v1/products/wallpage/verify
VITE_SOCIOBOT_LICENSE_VERIFY_URL=
