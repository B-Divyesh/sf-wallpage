# Public Wallpage Collector endpoints. These are browser-visible URLs, not
# credentials; payment is hosted by Sociobot/Dodo and licenses are verified
# server-side by Sociobot.
VITE_SOCIOBOT_BUY_URL=https://api.sociobot.in/api/v1/products/wallpage/checkout
VITE_SOCIOBOT_LICENSE_VERIFY_URL=https://api.sociobot.in/api/v1/products/wallpage/verify
